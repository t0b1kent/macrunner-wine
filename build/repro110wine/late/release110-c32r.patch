+/* WINEUP 03.11.2026: a FAULTING frameless leaf without .pdata (ntdll strlen, wcslen, ...). Windows (and upstream Wine) unwind a frame
+ * without a function entry as a leaf: pc = lr. The MacRunner fallbacks below were built for EC frames without metadata at CALL sites;
+ * for a faulting leaf the fp-chain method returned the caller's CALLER and skipped the caller's __try: lstrlenA -> strlen on a bad
+ * pointer killed native ARM64 processes (probe badptr_probe_arm64 lstrlenA_noacc, c25..c29). Conservative: the first (faulting) frame
+ * only, pc and lr inside loaded modules, and a linear scan from pc to the first ret / unconditional branch that meets no call, no write
+ * of sp (add/sub sp, pre/post-index on sp), no write of x29/x30. */
+static BOOL macrunner_wineup_faulting_leaf( DISPATCHER_CONTEXT *dispatch, CONTEXT *context, DWORD64 pc )
+{
+    LDR_DATA_TABLE_ENTRY *mod = NULL, *lr_mod = NULL;
+    const DWORD *insn;
+    unsigned int i;
+
+    if (dispatch->ControlPcIsUnwound || (context->ContextFlags & CONTEXT_UNWOUND_TO_CALL)) return FALSE;
+    if (pc < 0x10000 || (pc & 3) || context->Lr < 0x10000 || (context->Lr & 3)) return FALSE;
+    if (LdrFindEntryForAddress( (void *)(ULONG_PTR)pc, &mod ) || LdrFindEntryForAddress( (void *)(ULONG_PTR)context->Lr, &lr_mod ))
+        return FALSE;
+    insn = (const DWORD *)(ULONG_PTR)pc;
+    for (i = 0; i < 128; i++)
+    {
+        DWORD op = insn[i];
+        unsigned int rt = op & 0x1f, rt2 = (op >> 10) & 0x1f, rn = (op >> 5) & 0x1f;
+
+        if (op == 0xd65f03c0u || (op & 0xfc000000u) == 0x14000000u || (op & 0xfffffc1fu) == 0xd61f0000u) break; /* ret / b / br */
+        if ((op & 0xfc000000u) == 0x94000000u || (op & 0xfffffc1fu) == 0xd63f0000u) return FALSE;          /* bl / blr */
+        if ((op & 0x1f000000u) == 0x11000000u && !(op & 0x20000000u) && rt == 31) return FALSE;  /* add/sub (imm, not adds/cmp) Rd = sp */
+        if ((op & 0x3a000000u) == 0x28000000u && rn == 31 && (op & 0x00800000u)) return FALSE;   /* ldp/stp [sp] pre/post-index */
+        if ((op & 0x3b200c00u) == 0x38000c00u && rn == 31) return FALSE;      /* ldr/str [sp, #imm]! */
