+ *   • Перепись печатает то, что зарегистрировано В ЭТОМ образе. Прибор, которого
+ *     нет в загруженном двоичном, в переписи не появится вовсе — и именно поэтому
+ *     перепись печатает СВОЙ путь (dladdr) заголовком: пустой список у ожидаемого
+ *     образа — это ответ, а не молчание.
+ */
+#ifndef HB_PROBE_H
+#define HB_PROBE_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Состояние прибора. Выводится КОДОМ, а не суждением читателя. */
+typedef enum {
+    HB_PROBE_NOT_OBSERVED = 0,   /* looked == 0: управление до наблюдения не дошло */
+    HB_PROBE_NO_EVENTS,          /* looked > 0, hits == 0: смотрел, явления нет */
+    HB_PROBE_EVENTS,             /* hits > 0, напечатано всё */
+    HB_PROBE_EVENTS_COUNTED,     /* hits > 0, printed == 0: считалось, поштучно НЕ печаталось.
+                                  * ★ 06.09.2026 — состояние заведено, потому что БЕЗ НЕГО
+                                  * прибор-счётчик (HB_PROBE_HIT без HB_PROBE_SAY) попадал в
+                                  * EVENTS-TRUNCATED, а её легенда гласит «число — НИЖНЯЯ
+                                  * ГРАНИЦА». Для счётчика это ЛОЖЬ: hits точен, усечена
+                                  * только печать. Поймано на своих же приборах живости
+                                  * флагов в тот же день, когда они заводились. */
+    HB_PROBE_EVENTS_TRUNCATED,   /* hits > 0, потолок обрезал: число — НИЖНЯЯ ГРАНИЦА */
+    HB_PROBE_INCONSISTENT        /* hits > looked: LOOKED стоит внутри условия */
+} hb_probe_state_t;
+
+typedef struct hb_probe {
+    const char *name;         /* имя маркера, как оно ляжет в журнал */
+    const char *population;   /* ЧТО именно считает. Обязательно, пустое не компилируется */
+    const char *gate;         /* имя гейта или NULL, если прибор безусловен */
+    const char *file;         /* где объявлен */
+    int         line;
+    unsigned    cap;          /* потолок печати; 0 = без потолка */
+
+    /* Счётчики. Правятся атомарно: приборы стоят в многопоточных путях. */
+    unsigned long long looked;   /* сколько раз НАЧАЛОСЬ наблюдение (безусловно) */
+    unsigned long long hits;     /* сколько раз СЛУЧИЛОСЬ явление (всегда, без потолка) */
+    unsigned long long printed;  /* сколько раз реально напечатано */
+
+    const void *anchor;       /* адрес внутри образа — для dladdr; ставит регистратор */
+    struct hb_probe *next;
+
+    /* ★ 06.09.2026 — МЕТКА ОДНИМ ЛИТЕРАЛОМ, иначе перевод на hb_probe САМ создаёт
+     * новый ложный ноль. Первая редакция печатала префикс как `fprintf(stderr,
+     * "macrunner-%s: ", p->name)`. Формат и имя — ДВА РАЗНЫХ литерала, поэтому
+     * сплошной строки `macrunner-hb-write-deny:` в двоичном БОЛЬШЕ НЕТ, и всякая
+     * проверка доставки (`grep -a` по .so) находит НОЛЬ при исправном приборе.
+     * Поймал это привратник раскладки: он отказался класть ntdll.so, потому что
+     * метка была в цели и пропала в новом файле. Здесь литерал склеивается
+     * КОМПИЛЯТОРОМ ("macrunner-" imya ": "), поэтому метка лежит в двоичном
+     * целиком и доставка проверяется по-прежнему.
+     * Поле стоит В КОНЦЕ намеренно: в приёмке есть позиционный инициализатор
+     * hb_probe_t, и вставка поля в середину молча сдвинула бы его значения. */
+    const char *metka;
+} hb_probe_t;
+
+/* ── Реестр ────────────────────────────────────────────────────────────────── */
+
+/* Регистрация. Вызывается конструктором БЕЗУСЛОВНО: молчащий прибор всё равно
+ * попадёт в перепись. Возврат игнорируется намеренно — отказ регистрации
+ * зафиксируется как провал самопроверки, а не как тихая потеря прибора. */
+void hb_probe_register(hb_probe_t *p, const void *anchor);
+
+/* Классификатор. Отдельная чистая функция — чтобы самопроверка могла скормить ему
+ * заведомо плохие входы, не заводя настоящих приборов. */
+hb_probe_state_t hb_probe_state(const hb_probe_t *p);
+const char *hb_probe_state_name(hb_probe_state_t s);
+
+/* Перепись: печатает КАЖДЫЙ зарегистрированный прибор, включая молчащие.
+ * Перед печатью прогоняет самопроверку; провал делает всю перепись
+ * НЕДЕЙСТВИТЕЛЬНОЙ, а не «в основном верной». */
+void hb_probe_census(FILE *out);
+
+/* ── ★★★ ПУЛЬС ПЕРЕПИСИ — ПЕРЕПИСЬ ПЕРЕЖИВАЕТ УБИЙСТВО (лейн ОСНАСТКА, 07.09.2026) ──
+ *
+ * ДЕФЕКТ. Перепись ставилась ТОЛЬКО через atexit(). Наши прогоны снимаются убийством
+ * (timeout, wineserver -k, kill -9 в mr-run.sh), atexit при этом не наступает НИКОГДА.
+ * Замер лейна ПОВТОР-2: строк `macrunner-probe` в 300 журналах run.log — НОЛЬ, при
+ * строках движка в 40 из 40. То есть любой прибор, объявленный через HB_PROBE_DEFINE,
+ * в БОЕВОМ прогоне молчит — ровно то, ради чего hb_probe.h и писался.
+ * Движок это уже знал: у guard_census_flush стоит комментарий «Printed periodically
+ * rather than at exit because these runs die on the timeout's SIGKILL».
+ *
+ * ЛЕЧЕНИЕ УСТРОЙСТВОМ, а не обходом для одного прибора: перепись едет на ПУЛЬСЕ —
+ * вызове из любого БЕЗУСЛОВНОГО периодического места (у нас guard_census_flush,
+ * раз в 2^20 диспетчеризаций). Приборам знать об этом не нужно: подключился к
+ * hb_probe.h — попал в перепись, которая доезжает до журнала.
+ *
+ * КОГДА ПЕЧАТАЕТ (и почему именно так):
+ *   1. НИЧЕГО, пока приборов НОЛЬ. Пустая перепись «всё по нулям» неотличима от
+ *      переписи исправного молчащего образа — это был бы новый ложный ноль,
+ *      заведённый лекарством от старого. Отрицательный контроль в приёмке.
+ *   2. ПРИ СМЕНЕ СОСТОЯНИЯ хоть одного прибора. Состояние (не смотрел / смотрел,
+ *      нет / есть) и есть ПРЕДМЕТ переписи; переходов у прибора единицы за прогон.
+ *   3. На пульсах с НОМЕРОМ-СТЕПЕНЬЮ ДВОЙКИ (1,2,4,8,...) — чтобы величины не
+ *      устаревали на порядки. Это собственный приём проекта (так печатает
+ *      chain-thunk-exit). Даёт log2(N) печатей: за прогон HK ~217 пульсов -> 8.
+ *   4. НИКОГДА две ОДИНАКОВЫЕ подряд: отпечаток сверяется с предыдущим.
+ *   5. Ровно ОДНА окончательная (final=1) — на штатном выходе, через atexit,
+ *      под защёлкой. Промежуточные помечены final=0 и why=pulse: спутать снимок
+ *      с итогом нельзя, потому что это написано в самой строке.
+ *
+ * ЦЕНА снятия прогона: пульс, который НИЧЕГО не печатает, — это чтение трёх
+ * атомарных счётчиков на прибор. Печать случается ~10 раз за прогон. Числа — в
+ * приёмке (`make probe-test`) и в отчёте.
+ *
+ * why — короткая метка причины для журнала ("period", "recover", ...). NULL можно. */
+void hb_probe_census_pulse(FILE *out, const char *why);
+
+/* Сколько приборов зарегистрировано. Ноль означает «в этом образе приборов нет» —
+ * ответ, а не молчание. Открыто наружу ради приёмки и ради вызывающего, который
+ * хочет промолчать сам. */
+unsigned hb_probe_count(void);
+
+/* Сколько раз перепись РЕАЛЬНО напечаталась. Приёмке нужно отличить «пульс был и
+ * промолчал» от «пульса не было»: без этого проверка «не дублируется» проверяла бы
+ * собственное отсутствие. */
+unsigned hb_probe_census_printed_count(void);
+
+/* Самопроверка классификатора: 0 = прошла, иначе число провалившихся случаев.
+ * Гоняется сама при переписи; открыта наружу для приёмки. */
+int hb_probe_selftest(FILE *out);
+
+/* Учёт. Вынесены функциями, а не только макросами, чтобы приёмка могла дёргать их
+ * напрямую и чтобы точка учёта была ОДНА (а не по копии на каждом месте вызова). */
+void hb_probe_looked(hb_probe_t *p);
+void hb_probe_hit(hb_probe_t *p);
+/* Печатать ли на этот раз: hits уже увеличен, потолок проверен. */
+int  hb_probe_should_print(hb_probe_t *p);
+
+/* ── Объявление прибора ────────────────────────────────────────────────────── */
+
+/* Популяция обязана быть непустым СТРОКОВЫМ ЛИТЕРАЛОМ. Проверка компилятором:
+ * забыть описание не «плохой стиль», а ошибка сборки. Порог 9 = 8 значащих байт
+ * плюс нуль: короче осмысленного описания не бывает. */
+#define HB_PROBE_TREBUET_POPULYACII(populyaciya)                                   \
+    _Static_assert(sizeof(populyaciya) >= 9,                                       \
+        "hb_probe: поле population обязано быть непустым описанием того, ЧТО "     \
+        "прибор считает (какие события попадают в счёт, а какие нет)")
+
+#define HB_PROBE_DEFINE(var, imya, populyaciya, gejt, potolok)                     \
+    HB_PROBE_TREBUET_POPULYACII(populyaciya);                                      \
+    static hb_probe_t var = {                                                      \
+        /* .name       */ (imya),                                                  \
+        /* .population */ (populyaciya),                                           \
+        /* .gate       */ (gejt),                                                  \
+        /* .file       */ __FILE__,                                                \
+        /* .line       */ __LINE__,                                                \
+        /* .cap        */ (potolok),                                               \
+        /* .looked     */ 0, /* .hits */ 0, /* .printed */ 0,                      \
+        /* .anchor     */ 0, /* .next */ 0,                                        \
+        /* .metka      */ "macrunner-" imya ": "                                   \
+    };                                                                             \
+    __attribute__((constructor)) static void var##_hb_probe_reg(void)              \
+    {                                                                              \
+        hb_probe_register(&var, (const void *)(uintptr_t)&var##_hb_probe_reg);     \
+    }
+
+/* НАБЛЮДЕНИЕ НАЧАЛОСЬ. Ставится БЕЗУСЛОВНО — выше любых if. */
+#define HB_PROBE_LOOKED(p) hb_probe_looked(p)
+
+/* ЯВЛЕНИЕ СЛУЧИЛОСЬ: учесть всегда, напечатать пока не упёрлись в потолок.
+ * Голое число напечатать нельзя: строка несёт имя прибора, а перепись — популяцию,
+ * место и состояние. */
+#define HB_PROBE_SAY(p, ...)                                                       \
+    do {                                                                           \
+        hb_probe_t *_hb_p = (p);                                                   \
+        hb_probe_hit(_hb_p);                                                       \
+        if (hb_probe_should_print(_hb_p)) {                                        \
+            /* СПЛОШНОЙ литерал — см. разбор у поля .metka. Запасной путь нужен   \
+             * лишь для приборов, собранных не макросом (такие есть в приёмке).  */\
+            if (_hb_p->metka) fputs(_hb_p->metka, stderr);                         \
+            else fprintf(stderr, "macrunner-%s: ", _hb_p->name);                   \
+            fprintf(stderr, __VA_ARGS__);                                          \
+        }                                                                          \
+    } while (0)
+
+/* Явление, которое считаем, но не печатаем поштучно (частые события).
+ * Итог всё равно виден в переписи, и ноль остаётся отличимым. */
+#define HB_PROBE_HIT(p) hb_probe_hit(p)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* HB_PROBE_H */
