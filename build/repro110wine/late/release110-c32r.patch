-{
-#ifdef __APPLE__
-    long pgsz = sysconf( _SC_PAGESIZE );
-    size_t plen = pgsz > 0 ? (size_t)pgsz : 0x4000;
-    mach_vm_address_t page = (mach_vm_address_t)(addr & ~(unsigned long long)(plen - 1));
-    mach_vm_address_t probe;
-    mach_vm_size_t rsize = 0;
-    vm_region_basic_info_data_64_t info;
-    mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
-    mach_port_t object = MACH_PORT_NULL;
-
-    if (page < plen) return FALSE;
-    probe = page - plen;
-    if (mach_vm_region( mach_task_self(), &probe, &rsize, VM_REGION_BASIC_INFO_64,
-                        (vm_region_info_t)&info, &count, &object ) != KERN_SUCCESS)
-        return FALSE;
-    if (object != MACH_PORT_NULL) mach_port_deallocate( mach_task_self(), object );
-
-    /* регион должен НАКРЫВАТЬ страницу ниже нашей, быть читаемым и кончаться ровно на нашей */
-    if (probe > page - plen) return FALSE;
-    if (!(info.protection & VM_PROT_READ)) return FALSE;
-    return (probe + rsize == page);
-#else
-    (void)addr;
-    return FALSE;
-#endif
-}
