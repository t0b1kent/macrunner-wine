+/* CPU-LATE EVENT POOL (25.10.2026): MACRUNNER_EVENT_POOL=<cap> (default 0 = off; 1 = cap 256) - unnamed events without
+ * the wineserver on the steady path.
+ *
+ * Measured in Elden Ring (chapel): every job event costs three synchronous server requests - create_event, get_inproc_sync_fd
+ * on first use (msync takes the object index from the server) and close_handle - 69.8 of the 83 requests per frame, 33 of the
+ * 46 on the game's main thread. Set/Reset/Wait already run on the msync fast path without the server.
+ *
+ * NtClose of an event that is unnamed, has no security descriptor, is not inheritable, was never duplicated (in either
+ * direction), was never handed to an asynchronous I/O call and has no thread waiting on it does not go to the server: the event
+ * is reset and parked in a FIFO; NtCreateEvent of the same type (manual / auto reset) with exactly the same access takes the
+ * oldest parked event that has been parked at least MEP_QUARANTINE_MS and is still non-signaled (a late signal from an
+ * asynchronous source discards it with a real close), then sets the requested initial state. The handle value and the msync
+ * cache entry survive, so a reissued event costs no request at all.
+ *
+ * A parked handle behaves as closed in every ntdll call until it is reissued (checked on the fast path, no server): a second
+ * NtClose, waits (also inside WaitForMultipleObjects / SignalObjectAndWait), Set/Reset/Clear/Pulse/BoostPriority, NtQueryEvent,
+ * Release*, NtDuplicateObject (source), NtCompareObjects, NtQueryObject, NtSetInformationObject, Query/SetSecurityObject,
+ * NtMakeTemporaryObject and the event argument of asynchronous I/O calls return STATUS_INVALID_HANDLE.
+ * Known differences ntdll cannot close: the handle still exists in the server, so GetProcessHandleCount and the system handle
+ * table (SystemHandleInformation) count parked handles, and another process duplicating our handle value through the server
+ * reaches the parked object. Above the cap a close is a real close. */
+#include <mach/mach_time.h>
+#include <pthread.h>
+
+#define MEP_N 65536             /* handle index = value >> 2, handles below 0x40000 */
+#define MEP_QUARANTINE_MS 50
+
+static uint8_t mep_state[MEP_N];      /* 0 untracked, 1 live (poolable so far), 2 parked, 3 live but never poolable */
+static uint8_t mep_manual[MEP_N];
+static uint32_t mep_access[MEP_N];
+static int16_t mep_waiters[MEP_N];
+static uint64_t mep_since[MEP_N];
+static uint32_t mep_fifo[2][512];     /* parked indices, per type; capacity >= any cap */
+static int mep_head[2], mep_count[2];
+static int mep_cap = -1;
+static pthread_mutex_t mep_lock = PTHREAD_MUTEX_INITIALIZER;
+static __thread int mep_bypass;       /* the pool's own calls into Set/Reset/Query/Close */
+static uint64_t mep_hits, mep_misses, mep_parks, mep_real_closes, mep_discards, mep_invalid;
+static int mep_trace = -1;   /* MACRUNNER_EVENT_POOL_TRACE=N: first N pool decisions to stderr (probes only) */
+#define MEP_TRACE(...) do { if (mep_trace < 0) { const char *v_ = getenv( "MACRUNNER_EVENT_POOL_TRACE" ); mep_trace = v_ ? atoi( v_ ) : 0; } \
+    if (mep_trace > 0 && __atomic_sub_fetch( &mep_trace, 1, __ATOMIC_RELAXED ) >= 0) { fprintf( stderr, "macrunner_event_pool_trace tid=%04x ", HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ) ); fprintf( stderr, __VA_ARGS__ ); fputc( '\n', stderr ); } } while (0)
+
+static int mep_on(void)
+{
+    int c = __atomic_load_n( &mep_cap, __ATOMIC_ACQUIRE );
+    if (__builtin_expect( c >= 0, 1 )) return c;
+    {
+        const char *v = getenv( "MACRUNNER_EVENT_POOL" );
+        c = v ? atoi( v ) : 0;
+        if (c == 1) c = 256;
+        if (c < 0) c = 0;
+        if (c > 512) c = 512;
+        if (c) fprintf( stderr, "macrunner_event_pool_on cap=%d pid=%d\n", c, getpid() );
+        __atomic_store_n( &mep_cap, c, __ATOMIC_RELEASE );
+    }
+    return c;
+}
+
+static inline int mep_index( HANDLE handle )
+{
+    ULONG_PTR h = (ULONG_PTR)handle;
+    if (!h || (h & 3) || h >= 4ull * MEP_N) return -1;
+    return (int)(h >> 2);
+}
+
+/* fast-path check used by every handle-taking entry point */
+__attribute__((visibility("hidden"))) int mep_pooled( HANDLE handle )
+{
+    int i;
+    if (__builtin_expect( mep_cap <= 0, 1 ) || mep_bypass) return 0;
+    if ((i = mep_index( handle )) < 0) return 0;
+    if (__atomic_load_n( &mep_state[i], __ATOMIC_ACQUIRE ) != 2) return 0;
+    __atomic_add_fetch( &mep_invalid, 1, __ATOMIC_RELAXED );
+    return 1;
+}
+
+/* a tracked live event becomes never-poolable (duplicated, inherited, given to asynchronous I/O) */
+__attribute__((visibility("hidden"))) void mep_poison( HANDLE handle )
+{
+    int i;
+    if (mep_cap <= 0 || (i = mep_index( handle )) < 0) return;
+    pthread_mutex_lock( &mep_lock );
+    if (mep_state[i] == 1) mep_state[i] = 3;
+    pthread_mutex_unlock( &mep_lock );
+}
+
+static int mep_eligible( const OBJECT_ATTRIBUTES *attr )
+{
+    if (!attr) return 1;
+    if (attr->ObjectName && attr->ObjectName->Length) return 0;
+    if (attr->SecurityDescriptor || attr->SecurityQualityOfService || attr->RootDirectory) return 0;
+    if (attr->Attributes & OBJ_INHERIT) return 0;
+    return 1;
+}
+
+static void mep_created( HANDLE handle, ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr, EVENT_TYPE type )
+{
+    int i;
+    if (mep_on() <= 0 || (i = mep_index( handle )) < 0) return;
+    pthread_mutex_lock( &mep_lock );
+    mep_state[i] = mep_eligible( attr ) ? 1 : 3;
+    MEP_TRACE( "created h=%x state=%d", i << 2, mep_state[i] );
+    mep_manual[i] = type == NotificationEvent;
+    mep_access[i] = access;
+    mep_waiters[i] = 0;
+    pthread_mutex_unlock( &mep_lock );
+}
+
+static NTSTATUS mep_real_close( HANDLE handle );
+
+/* reissue a parked event; TRUE when *handle was filled */
+static BOOL mep_take( HANDLE *handle, ACCESS_MASK access, const OBJECT_ATTRIBUTES *attr, EVENT_TYPE type, BOOLEAN state )
+{
+    int t = type == NotificationEvent, tries;
+    uint64_t now, q;
+    mach_timebase_info_data_t tb;
+
+    if (mep_on() <= 0 || !mep_eligible( attr ) || (type != NotificationEvent && type != SynchronizationEvent)) return FALSE;
+    mach_timebase_info( &tb );
+    q = (uint64_t)MEP_QUARANTINE_MS * 1000000ull * tb.denom / tb.numer;
+    for (tries = 0; tries < 4; tries++)
+    {
+        int i = -1;
+        EVENT_BASIC_INFORMATION info;
+        now = mach_absolute_time();
+        pthread_mutex_lock( &mep_lock );
+        if (mep_count[t])
+        {
+            int j = mep_fifo[t][mep_head[t]];
+            if (mep_access[j] == access && now - mep_since[j] >= q && mep_state[j] == 2)
+            {
+                i = j;
+                mep_head[t] = (mep_head[t] + 1) % 512;
+                mep_count[t]--;
+                mep_state[i] = 1;
+                mep_waiters[i] = 0;
+            }
+        }
+        pthread_mutex_unlock( &mep_lock );
+        if (i < 0) break;
+        mep_bypass++;
+        if (!NtQueryEvent( ULongToHandle( i << 2 ), EventBasicInformation, &info, sizeof(info), NULL ) && !info.EventState)
+        {
+            if (state) NtSetEvent( ULongToHandle( i << 2 ), NULL );
+            mep_bypass--;
+            *handle = ULongToHandle( i << 2 );
+            MEP_TRACE( "take h=%x manual=%d state=%d", i << 2, t, state );
+            __atomic_add_fetch( &mep_hits, 1, __ATOMIC_RELAXED );
+            return TRUE;
+        }
+        mep_bypass--;
+        /* signalled while parked (an asynchronous source still held it): never reuse it */
+        pthread_mutex_lock( &mep_lock ); mep_state[i] = 0; pthread_mutex_unlock( &mep_lock );
+        mep_real_close( ULongToHandle( i << 2 ) );
+        __atomic_add_fetch( &mep_discards, 1, __ATOMIC_RELAXED );
+    }
+    __atomic_add_fetch( &mep_misses, 1, __ATOMIC_RELAXED );
+    return FALSE;
+}
+
+/* NtClose hook: 0 = not ours (normal close follows), 1 = handled with *status (NTSTATUS values are negative ints) */
+__attribute__((visibility("hidden"))) int mep_close( HANDLE handle, NTSTATUS *status )
+{
+    int i, t, park = 0;
+    if (mep_cap <= 0 || mep_bypass || (i = mep_index( handle )) < 0) return 0;
+    pthread_mutex_lock( &mep_lock );
+    switch (mep_state[i])
+    {
+    case 2: pthread_mutex_unlock( &mep_lock ); __atomic_add_fetch( &mep_invalid, 1, __ATOMIC_RELAXED ); MEP_TRACE( "close h=%x parked -> INVALID", i << 2 ); *status = STATUS_INVALID_HANDLE; return 1;
+    case 1:
+        t = mep_manual[i];
+        if (!mep_waiters[i] && mep_count[0] + mep_count[1] < mep_cap)
+        {
+            mep_state[i] = 2;   /* closed for everybody from now on */
+            park = 1;
+        }
+        else mep_state[i] = 0;
+        break;
+    case 3: mep_state[i] = 0; break;
+    default: break;
+    }
+    pthread_mutex_unlock( &mep_lock );
+    MEP_TRACE( "close h=%x park=%d state_now=%d waiters=%d", i << 2, park, mep_state[i], mep_waiters[i] );
+    if (!park) return 0;
+    mep_bypass++;
+    if (NtResetEvent( handle, NULL ))
+    {
+        mep_bypass--;
+        pthread_mutex_lock( &mep_lock ); mep_state[i] = 0; pthread_mutex_unlock( &mep_lock );
+        return 0;
+    }
+    mep_bypass--;
+    pthread_mutex_lock( &mep_lock );
+    mep_since[i] = mach_absolute_time();
+    mep_fifo[t][(mep_head[t] + mep_count[t]) % 512] = i;
+    mep_count[t]++;
+    pthread_mutex_unlock( &mep_lock );
+    {
+        uint64_t n = __atomic_add_fetch( &mep_parks, 1, __ATOMIC_RELAXED );
+        if (!(n & 0x3fff))
+            fprintf( stderr, "macrunner_event_pool pid=%d parks=%llu hits=%llu misses=%llu discards=%llu real_closes=%llu invalid=%llu parked=%d\n",
+                     getpid(), (unsigned long long)n, (unsigned long long)mep_hits, (unsigned long long)mep_misses,
+                     (unsigned long long)mep_discards, (unsigned long long)mep_real_closes, (unsigned long long)mep_invalid,
+                     mep_count[0] + mep_count[1] );
+    }
+    *status = STATUS_SUCCESS;
+    return 1;
+}
+
+static NTSTATUS mep_real_close( HANDLE handle )
+{
+    NTSTATUS ret;
+    mep_bypass++;
+    ret = NtClose( handle );
+    mep_bypass--;
+    __atomic_add_fetch( &mep_real_closes, 1, __ATOMIC_RELAXED );
+    return ret;
+}
+
+/* waits: count waiters on tracked live events; a parked handle anywhere in the set fails the whole wait */
+static NTSTATUS mep_wait_enter( const HANDLE *handles, DWORD count )
+{
+    DWORD k, j;
+    if (mep_cap <= 0 || mep_bypass) return STATUS_SUCCESS;
+    pthread_mutex_lock( &mep_lock );
+    for (k = 0; k < count; k++)
+    {
+        int i = mep_index( handles[k] );
+        if (i < 0) continue;
+        if (mep_state[i] == 2)
+        {
+            for (j = 0; j < k; j++) { int m = mep_index( handles[j] ); if (m >= 0 && (mep_state[m] == 1 || mep_state[m] == 3) && mep_waiters[m] > 0) mep_waiters[m]--; }
+            pthread_mutex_unlock( &mep_lock );
+            __atomic_add_fetch( &mep_invalid, 1, __ATOMIC_RELAXED );
+            return STATUS_INVALID_HANDLE;
+        }
+        if (mep_state[i] == 1 || mep_state[i] == 3) mep_waiters[i]++;
+    }
+    pthread_mutex_unlock( &mep_lock );
+    return STATUS_SUCCESS;
+}
+
+static void mep_wait_leave( const HANDLE *handles, DWORD count )
+{
+    DWORD k;
+    if (mep_cap <= 0 || mep_bypass) return;
+    pthread_mutex_lock( &mep_lock );
+    for (k = 0; k < count; k++)
+    {
+        int i = mep_index( handles[k] );
+        if (i >= 0 && mep_waiters[i] > 0) mep_waiters[i]--;
+    }
+    pthread_mutex_unlock( &mep_lock );
+}
+
+/* NtDuplicateObject: a parked source is a closed handle; any duplicate poisons the source; CLOSE_SOURCE closes it for real */
+__attribute__((visibility("hidden"))) int mep_dup_pre( HANDLE src_process, HANDLE source, ULONG options )
+{
+    int i;
+    if (mep_cap <= 0 || src_process != NtCurrentProcess() || (i = mep_index( source )) < 0) return 0;
+    if (mep_pooled( source )) return STATUS_INVALID_HANDLE;
+    pthread_mutex_lock( &mep_lock );
+    if (mep_state[i] == 1 || mep_state[i] == 3) mep_state[i] = (options & DUPLICATE_CLOSE_SOURCE) ? 0 : 3;
+    MEP_TRACE( "dup src=%x state_now=%d", i << 2, mep_state[i] );
+    pthread_mutex_unlock( &mep_lock );
+    return 0;
+}
+
+/* asynchronous I/O keeps a reference to its event in the server: never pool such an event */
+__attribute__((visibility("hidden"))) int mep_io_event( HANDLE event )
+{
+    if (!event || mep_cap <= 0) return 0;
+    if (mep_pooled( event )) return STATUS_INVALID_HANDLE;
+    mep_poison( event );
+    return 0;
+}
