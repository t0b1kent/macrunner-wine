+    MRW_CFP_MOUSEMSG, MRW_CFP_API,                                     /* get_window_children_from_point: caller */
+    MRW_HW_MOUSE, MRW_HW_MOUSEMOVE, MRW_HW_KEY, MRW_HW_OTHER, MRW_ACCEPT_HW,
+    MRW_CFE_SETCURSOR, MRW_CFE_ASYNCKEY, MRW_CFE_QSTATUS, MRW_CFE_LASTINPUT, MRW_CFE_PAINT,
