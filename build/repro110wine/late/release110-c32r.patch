-/* MacRunner 2026-09-06, лейн ПЕРЕХОДНИКИ — РАЗРЕШЕНИЕ ЦЕПОЧКИ ОДИН РАЗ.
- *
- * Цепочка ниже (macrunner_hb_call_import_thunk) перебирала 38 обработчиков на КАЖДЫЙ
- * импортный вызов гостя, и 37 из 38 отказывались, сравнив строки. Замер лейна ГЕЙТЫ по
- * снимку sample: 2,63 % занятого времени критического потока уходило на сравнение имён
- * DLL и импортов (macrunner_hb_strieq 2,22 % + strncmp вне getenv 0,41 %).
- *
- * Какой обработчик МОЖЕТ взять вызов, зависит только от пары (dll_name, import_name), а она
- * у переходника постоянна. Поэтому ответ считается один раз — при заведении переходника — и
- * кладётся в его структуру маской. Тот же приём уже применён в этом файле к двум
- * обработчикам из 38 (semantic_class, строка 167) с тем же контрактом: пере-классификация
- * безвредна (обработчик исполняет свои проверки и вернёт FALSE), недо-классификация молча
- * теряет обработку. Поэтому каждый предикат macrunner_hb_thunk_may_* содержит ДОСЛОВНО то
- * условие, что стояло первым оператором своего обработчика, и зовётся из него же — код
- * существует в одном экземпляре и разъехаться с телом не может.
- *
- * Порядок битов = порядок цепочки: `||` означает «первый совпавший выигрывает», и на корпусе
- * из 763 реальных импортов Hollow Knight у 40,6 % пар кандидатов НЕ ОДИН (до 10), так что
- * порядок здесь несущий, а не декоративный.
- *
- * MACRUNNER_HB_THUNK_ROUTE=0 возвращает прежний полный перебор (маска = все 38 бит) — рука
- * сравнения для A/B и страховка. */
-static BOOL macrunner_hb_thunk_route_enabled(void)
-{
-    static int enabled = -1;
-    int value = __atomic_load_n( &enabled, __ATOMIC_RELAXED );
-
-    if (value < 0)
-    {
-        value = macrunner_hb_env_enabled_default_on( "MACRUNNER_HB_THUNK_ROUTE" );
-        __atomic_store_n( &enabled, value, __ATOMIC_RELAXED );
-    }
-    return value != 0;
-}
