+/* CPU-LATE WAIT (25.10.2026): request time inside the server, off by default. Enabled by MACRUNNER_SERVER_REQ_STATS=<s> in
+ * the server's environment or by the file <config dir>/macrunner-server-req-stats holding <s> (the app's warm wineserver
+ * does not inherit a run's environment). For every request code: count, handler time, reply-write time; per period: the
+ * share of the period spent in handlers, how many requests started less than 2 us after the previous one ended (back to
+ * back = a queue was waiting), and the server thread's CPU time and Mach priority. Line: macrunner_server_req (stderr),
+ * every <s>, printed by the request that crosses the period. */
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+static int mrq_period = -1;
+static uint64_t mrq_period_ticks, mrq_next, mrq_prev_end, mrq_b2b, mrq_cpu_us;
+static mach_timebase_info_data_t mrq_tb;
+static struct { uint64_t n, h, r, hmax; } mrq[REQ_NB_REQUESTS + 1];
+static struct { uint64_t n, h, r; } mrq_prev[REQ_NB_REQUESTS + 1];
+
+static int mrq_on(void)
+{
+    if (mrq_period < 0)
+    {
+        const char *v = getenv( "MACRUNNER_SERVER_REQ_STATS" );
+        char buf[16] = "";
+        int p = v ? atoi( v ) : 0;
+        if (!p && config_dir_fd != -1)
+        {
+            int fd = openat( config_dir_fd, "macrunner-server-req-stats", O_RDONLY );
+            if (fd != -1) { if (read( fd, buf, sizeof(buf) - 1 ) > 0) p = atoi( buf ); close( fd ); }
+        }
+        mrq_period = p > 0 ? p : 0;
+        if (mrq_period)
+        {
+            mach_timebase_info( &mrq_tb );
+            mrq_period_ticks = (uint64_t)mrq_period * 1000000000ull * mrq_tb.denom / mrq_tb.numer;
+            mrq_next = mach_absolute_time() + mrq_period_ticks;
+            fprintf( stderr, "macrunner_server_req_on period_s=%d pid=%d\n", mrq_period, getpid() );
+        }
+    }
+    return mrq_period;
+}
+
+static void mrq_print( uint64_t now )
+{
+    double ms = (double)mrq_tb.numer / mrq_tb.denom / 1e6;
+    struct thread_basic_info bi;
+    struct policy_timeshare_info ts;
+    mach_msg_type_number_t c1 = THREAD_BASIC_INFO_COUNT, c2 = POLICY_TIMESHARE_INFO_COUNT;
+    mach_port_t self = mach_thread_self();
+    uint64_t cpu = 0, n = 0, busy = 0;
+    int base = -1, cur = -1, i, k, used[REQ_NB_REQUESTS + 1];
+    char line[4096];
+    int at;
+
+    if (thread_info( self, THREAD_BASIC_INFO, (thread_info_t)&bi, &c1 ) == KERN_SUCCESS)
+        cpu = (uint64_t)(bi.user_time.seconds + bi.system_time.seconds) * 1000000 + bi.user_time.microseconds + bi.system_time.microseconds;
+    if (thread_info( self, THREAD_SCHED_TIMESHARE_INFO, (thread_info_t)&ts, &c2 ) == KERN_SUCCESS) { base = ts.base_priority; cur = ts.cur_priority; }
+    mach_port_deallocate( mach_task_self(), self );
+    for (i = 0; i <= REQ_NB_REQUESTS; i++) { n += mrq[i].n - mrq_prev[i].n; busy += (mrq[i].h - mrq_prev[i].h) + (mrq[i].r - mrq_prev[i].r); used[i] = 0; }
+    at = snprintf( line, sizeof(line), "macrunner_server_req pid=%d t_ms=%.0f n=%llu busy_ms=%.1f b2b=%llu cpu_ms=%.1f pri=%d/%d req=",
+                   getpid(), now * ms, (unsigned long long)n, busy * ms, (unsigned long long)mrq_b2b, (cpu - mrq_cpu_us) / 1000.0, base, cur );
+    for (k = 0; k < 24; k++)
+    {
+        uint64_t bt = 0; int best = -1;
+        for (i = 0; i <= REQ_NB_REQUESTS; i++)
+        {
+            uint64_t d = (mrq[i].h - mrq_prev[i].h) + (mrq[i].r - mrq_prev[i].r);
+            if (!used[i] && mrq[i].n != mrq_prev[i].n && d >= bt) { bt = d; best = i; }
+        }
+        if (best < 0 || at > (int)sizeof(line) - 96) break;
+        used[best] = 1;
+        at += snprintf( line + at, sizeof(line) - at, "%d:%llu:%.3f:%.3f:%.3f,", best, (unsigned long long)(mrq[best].n - mrq_prev[best].n),
+                        (mrq[best].h - mrq_prev[best].h) * ms, (mrq[best].r - mrq_prev[best].r) * ms, mrq[best].hmax * ms );
+        mrq[best].hmax = 0;
+    }
+    fprintf( stderr, "%s\n", line );
+    fflush( stderr );
+    for (i = 0; i <= REQ_NB_REQUESTS; i++) { mrq_prev[i].n = mrq[i].n; mrq_prev[i].h = mrq[i].h; mrq_prev[i].r = mrq[i].r; }
+    mrq_b2b = 0; mrq_cpu_us = cpu;
+}
+
+static void mrq_note( enum request req, uint64_t t0, uint64_t t1 )
+{
+    uint64_t t2 = mach_absolute_time();
+    unsigned int i = req < REQ_NB_REQUESTS ? req : REQ_NB_REQUESTS;
+    if (mrq_prev_end && t0 - mrq_prev_end < 2000ull * mrq_tb.denom / mrq_tb.numer) mrq_b2b++;
+    mrq_prev_end = t2;
+    mrq[i].n++; mrq[i].h += t1 - t0; mrq[i].r += t2 - t1;
+    if (t1 - t0 > mrq[i].hmax) mrq[i].hmax = t1 - t0;
+    if (t2 >= mrq_next) { mrq_print( t2 ); mrq_next = t2 + mrq_period_ticks; }
+}
+
+/* CPU-LATE SERVER QOS (25.10.2026): MACRUNNER_SERVER_QOS=<level> in the server's environment or the file
+ * <config dir>/macrunner-server-qos holding <level>; default 0 = unchanged. Measured in Elden Ring: the server thread sits
+ * at Mach 31 under game threads at 36-47 and is ready-but-not-running ~15% of the time, so a 2-8 us request costs 20-60 us
+ * of delivery. Raises the request thread once, with what macOS allows a user process (no root, no system setting):
+ *   1 - QoS class USER_INTERACTIVE (Mach base 47);
+ *   2 - precedence importance +20 on the timeshare policy (Mach base 51, above every game thread but the fixed 63 ones).
+ * Line: macrunner_server_qos (stderr) with the result and the priority after. */
+#include <pthread/qos.h>
+static void mrq_qos_once(void)
+{
+    static int done;
+    const char *v;
+    char buf[16] = "";
+    int level, rc = -1;
+    mach_port_t self;
+    struct policy_timeshare_info ts;
+    mach_msg_type_number_t cnt = POLICY_TIMESHARE_INFO_COUNT;
+
+    if (done) return;
+    done = 1;
+    v = getenv( "MACRUNNER_SERVER_QOS" );
+    level = v ? atoi( v ) : 0;
+    if (!v && config_dir_fd != -1)
+    {
+        int fd = openat( config_dir_fd, "macrunner-server-qos", O_RDONLY );
+        if (fd != -1) { if (read( fd, buf, sizeof(buf) - 1 ) > 0) level = atoi( buf ); close( fd ); }
+    }
+    if (level <= 0) return;
+    self = mach_thread_self();
+    if (level == 1) rc = pthread_set_qos_class_self_np( QOS_CLASS_USER_INTERACTIVE, 0 );
+    else if (level == 2)
+    {
+        struct thread_precedence_policy pp = { 20 };
+        rc = thread_policy_set( self, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&pp, THREAD_PRECEDENCE_POLICY_COUNT );
+    }
+    ts.base_priority = ts.cur_priority = -1;
+    thread_info( self, THREAD_SCHED_TIMESHARE_INFO, (thread_info_t)&ts, &cnt );
+    mach_port_deallocate( mach_task_self(), self );
+    fprintf( stderr, "macrunner_server_qos level=%d rc=%d pri=%d/%d pid=%d\n", level, rc, ts.base_priority, ts.cur_priority, getpid() );
+    fflush( stderr );
+}
