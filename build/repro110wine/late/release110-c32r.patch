-    if (protection & VM_PROT_READ) perm |= HB_PERM_READ;
-    if (protection & VM_PROT_WRITE) perm |= HB_PERM_WRITE;
-    if (protection & VM_PROT_EXECUTE) perm |= HB_PERM_EXEC;
