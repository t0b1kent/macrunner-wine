+        memcpy( mws_mod[n].name, name, sizeof(name) );
+        __atomic_store_n( &mws_nmod, n + 1, __ATOMIC_RELEASE );
+        m = mws_code_in( n, addr );
+    }
+done:
+    pthread_mutex_unlock( &mws_mod_lock );
+    if (addr < (1ull << 56)) __atomic_store_n( &mws_addr_cache[h], ((uint64_t)(m + 1) << 56) | addr, __ATOMIC_RELAXED );
+    return m;
+}
+
+/* the waiting code: the first code address outside the system modules (ntdll, kernelbase, kernel32, CRT) - the syscall's
+ * return address, then the frame-pointer chain, then a scan of the caller's stack (96 slots above the syscall sp; only
+ * addresses inside executable sections of images or executable non-image memory count). The system modules here are built
+ * without frame records (x29 = 0 at the syscall), so the scan is what usually finds the caller.
+ * MACRUNNER_WAIT_STATS_DEBUG=N prints the first N lookups that end in "sys". */
+static int mws_origin( struct mws_thread *t )
+{
+    static int debug = -1;
+    const char *frame = (const char *)get_syscall_frame();
+    TEB *teb = NtCurrentTeb();
+    ULONG_PTR lo = (ULONG_PTR)teb->Tib.StackLimit, hi = (ULONG_PTR)teb->Tib.StackBase;
+    ULONG_PTR fp, lr, sp, seen[8];
+    int depth, m, nseen = 0, i;
+
+    if (!frame) return MWS_SYS;
+    fp = *(const ULONG64 *)(frame + 0xe8);
+    lr = *(const ULONG64 *)(frame + 0xf0);
+    sp = *(const ULONG64 *)(frame + 0xf8);
+    for (depth = 0; depth < 12; depth++)
+    {
+        m = mws_module_of( lr );
+        if (m == MWS_ANON || (m > MWS_DATA && !mws_mod[m].system)) return m;
+        if (nseen < 8) seen[nseen++] = lr;
+        if (fp < lo || fp + 16 > hi || (fp & 7)) break;
+        lr = ((const ULONG64 *)fp)[1];
+        if (((const ULONG64 *)fp)[0] <= fp) break;
+        fp = ((const ULONG64 *)fp)[0];
+    }
+    if (!(sp >= lo && sp < hi) && !(sp >= t->stk_lo && sp < t->stk_hi))
+    {
+        MEMORY_BASIC_INFORMATION mbi;
+        if (!NtQueryVirtualMemory( NtCurrentProcess(), (void *)sp, MemoryBasicInformation, &mbi, sizeof(mbi), NULL ) &&
+            mbi.State == MEM_COMMIT && !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+        {
+            t->stk_lo = (ULONG_PTR)mbi.BaseAddress;
+            t->stk_hi = (ULONG_PTR)mbi.BaseAddress + mbi.RegionSize;
+        }
+    }
+    if (!(sp >= lo && sp < hi) && sp >= t->stk_lo && sp < t->stk_hi) { lo = t->stk_lo; hi = t->stk_hi; }
+    if (sp >= lo && sp < hi && !(sp & 7))
+    {
+        const ULONG64 *slot = (const ULONG64 *)sp;
+        for (i = 0; i < 96 && (ULONG_PTR)(slot + i + 1) <= hi; i++)
+        {
+            ULONG_PTR v = slot[i];
+            if (v < 0x10000 || v >= 0x800000000000ull || (v >= lo && v < hi)) continue;
+            m = mws_module_of( v );
+            if (m == MWS_DATA) continue;
+            if (m == MWS_ANON || !mws_mod[m].system) return m;
+            if (nseen < 8) seen[nseen++] = v;
+        }
+    }
+    if (debug < 0) { const char *v = getenv( "MACRUNNER_WAIT_STATS_DEBUG" ); debug = v ? atoi( v ) : 0; }
+    if (debug > 0 && __atomic_sub_fetch( &debug, 1, __ATOMIC_RELAXED ) >= 0)
+    {
+        char buf[1024];
+        int at = 0;
+        for (i = 0; i < nseen && at < (int)sizeof(buf) - 96; i++)
+        {
+            int mm = mws_module_of( seen[i] );
+            at += snprintf( buf + at, sizeof(buf) - at, " %lx(%s)", (unsigned long)seen[i], mws_mod[mm].name );
+        }
+        fprintf( stderr, "macrunner_wait_chain pid=%d tid=%04x lo=%lx hi=%lx fp=%lx sp=%lx code:%s\n",
+                 getpid(), HandleToULong( teb->ClientId.UniqueThread ), (unsigned long)lo, (unsigned long)hi,
+                 (unsigned long)*(const ULONG64 *)(frame + 0xe8), (unsigned long)sp, buf );
+    }
+    return MWS_SYS;
+}
+
+static inline DWORD mws_tid(void) { return HandleToULong( NtCurrentTeb()->ClientId.UniqueThread ); }
+static inline struct mws_hinfo *mws_hslot( ULONG_PTR h ) { return &mws_h[(h >> 2) & (MWS_NH - 1)]; }
+static inline struct mws_hinfo *mws_hget( ULONG_PTR h )
+{
+    struct mws_hinfo *e = mws_hslot( h );
+    return (h && h < 0xffffffffull && e->handle == (uint32_t)h) ? e : NULL;
+}
+static inline ULONG_PTR mws_root( ULONG_PTR h )
+{
+    struct mws_hinfo *e = mws_hget( h );
+    return e && e->root ? e->root : h;
+}
+
+/* creation of a waitable object (type, creating thread and module) */
+static void mws_note_create( HANDLE handle, int type )
+{
+    ULONG_PTR h = (ULONG_PTR)handle;
+    struct mws_thread *t;
+    struct mws_hinfo *e;
+    if (!mws_on() || !h || h >= 0xffffffffull) return;
+    t = mws_get_self();
+    e = mws_hslot( h );
+    e->handle = (uint32_t)h; e->root = (uint32_t)h; e->type = type;
+    e->creator_tid = mws_tid(); e->creator_mod = t ? mws_origin( t ) : MWS_SYS;
+    e->signal_tid = 0; e->signal_time = 0; e->queried = 1;
+    if (t && type < MWS_H_NTYPE) t->cr[type]++;
+}
+
+/* DuplicateHandle inside this process: the duplicate maps to the source's root object */
+__attribute__((visibility("hidden"))) void mws_note_dup( HANDLE src_process, HANDLE source, HANDLE dst_process, HANDLE dest )
+{
+    ULONG_PTR s = (ULONG_PTR)source, d = (ULONG_PTR)dest;
+    struct mws_hinfo *es, *ed;
+    if (__atomic_load_n( &mws_period, __ATOMIC_RELAXED ) <= 0) return;
+    if (src_process != NtCurrentProcess() || dst_process != NtCurrentProcess() || !s || !d || s >= 0xffffffffull || d >= 0xffffffffull) return;
+    if (!(es = mws_hget( s )))
+    {
+        es = mws_hslot( s );
+        es->handle = (uint32_t)s; es->root = (uint32_t)s; es->type = MWS_H_UNKNOWN;
+        es->creator_tid = 0; es->creator_mod = MWS_SYS; es->signal_tid = 0; es->signal_time = 0;
+    }
+    ed = mws_hslot( d );
+    if (ed == es) return;
+    ed->handle = (uint32_t)d; ed->root = es->root ? es->root : (uint32_t)s;
+    ed->type = es->type; ed->creator_tid = es->creator_tid; ed->creator_mod = es->creator_mod;
+    ed->signal_tid = 0; ed->signal_time = 0; ed->queried = es->queried;
+    if (mws_self) mws_self->cr[MWS_H_DUP]++;
+}
+
+static void mws_note_signal( HANDLE handle )
+{
+    ULONG_PTR h = (ULONG_PTR)handle, r;
+    struct mws_hinfo *e;
+    if (!mws_on() || !h || h >= 0xffffffffull) return;
+    r = mws_root( h );
+    if (!(e = mws_hget( r )))
+    {
+        e = mws_hslot( r );
+        e->handle = (uint32_t)r; e->root = (uint32_t)r; e->type = MWS_H_UNKNOWN;
+        e->creator_tid = 0; e->creator_mod = MWS_SYS;
+    }
+    e->signal_tid = mws_tid();
+    __atomic_store_n( &e->signal_time, mach_absolute_time(), __ATOMIC_RELEASE );
+}
+
+static void mws_note_alert( HANDLE tid )
+{
+    unsigned int i;
+    if (!mws_on()) return;
+    i = (HandleToULong( tid ) >> 2) & 4095;
+    mws_alert_tid[i] = mws_tid();
+    __atomic_store_n( &mws_alert_time[i], mach_absolute_time(), __ATOMIC_RELEASE );
+}
+
+/* synchronous wineserver requests (server.c server_call_unlocked); only threads already registered, no allocation (also
+ * runs inside signal handlers) */
+__attribute__((visibility("hidden"))) unsigned long long mws_srv_begin(void)
+{
+    return (__atomic_load_n( &mws_period, __ATOMIC_RELAXED ) > 0 && mws_self) ? mach_absolute_time() : 0;
+}
+
+__attribute__((visibility("hidden"))) void mws_srv_end( int code, unsigned long long t0 )
+{
+    struct mws_thread *t = mws_self;
+    uint64_t dt;
+    if (!t0 || !t) return;
+    dt = mach_absolute_time() - t0;
+    if (code < 0 || code >= MWS_NREQ) code = MWS_NREQ;
+    t->srv[code].n++; t->srv[code].t += dt;
+    if (t->depth > 0) { t->srv_in_wait.n++; t->srv_in_wait.t += dt; }
+}
+
+/* object type of a handle nobody was seen creating (one server request per root object) */
+static int mws_query_type( HANDLE handle )
+{
+    static const struct { const WCHAR *name; int type; } names[] = {
+        { u"Event", MWS_H_EVENT }, { u"Semaphore", MWS_H_SEM }, { u"Mutant", MWS_H_MUTANT }, { u"Timer", MWS_H_TIMER },
+        { u"Thread", MWS_H_THREAD }, { u"Process", MWS_H_PROCESS }, { u"IoCompletion", MWS_H_IOCP }, { u"File", MWS_H_FILE } };
+    union { OBJECT_TYPE_INFORMATION info; char buf[256]; } u;
+    ULONG len = 0;
+    unsigned int i;
+    if (NtQueryObject( handle, ObjectTypeInformation, &u, sizeof(u), &len )) return MWS_H_UNKNOWN;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        size_t n = 0;
+        while (names[i].name[n]) n++;
+        if (u.info.TypeName.Length == n * sizeof(WCHAR) && !memcmp( u.info.TypeName.Buffer, names[i].name, n * sizeof(WCHAR) ))
+            return names[i].type;
+    }
+    return MWS_H_OTHER;
+}
+
+static inline uint64_t mws_begin( struct mws_thread **pt )
+{
+    struct mws_thread *t;
+    *pt = NULL;
+    if (__builtin_expect( !mws_on(), 1 )) return 0;
+    if (!(t = mws_get_self())) return 0;
+    if (t->depth++) return 0;     /* nested (DelayExecution -> YieldExecution): counted by the outer wrapper */
+    *pt = t;
+    return mach_absolute_time();
+}
+
+static void mws_nested_end( void )
+{
+    if (mws_period > 0 && mws_self && mws_self->depth > 0) mws_self->depth--;
+}
+
+static void mws_end( struct mws_thread *t, int kind, uint64_t t0, NTSTATUS ret, HANDLE woken )
+{
+    uint64_t now, dt, st = 0, lat = 0;
+    DWORD waker = 0;
+    ULONG_PTR r = 0;
+    int o, i, cls_type = -1, cls_mod = 0;
+
+    if (!t) { mws_nested_end(); return; }
+    now = mach_absolute_time();
+    dt = now - t0;
+    t->depth--;
+    t->k[kind].n++;
+    t->k[kind].t += dt;
+    if (kind == MWS_YIELD || kind == MWS_DELAY0)
+    {
+        o = mws_origin( t );
+        for (i = 0; i < MWS_NSPIN - 1 && t->spin_mod[i] != o && t->spin_mod[i] != -1; i++) ;
+        if (t->spin_mod[i] == -1) t->spin_mod[i] = o;
+        else if (t->spin_mod[i] != o) t->spin_mod[i] = -2;
+        t->spin[i].n++; t->spin[i].t += dt;
+        return;
+    }
+    if (dt > t->kmax[kind]) t->kmax[kind] = dt;
+    if (ret == STATUS_TIMEOUT) t->timeouts++;
+    o = mws_origin( t );
+    for (i = 0; i < MWS_NORG - 1 && t->org_mod[i] != o && t->org_mod[i] != -1; i++) ;
+    if (t->org_mod[i] == -1) t->org_mod[i] = o;
+    else if (t->org_mod[i] != o) t->org_mod[i] = -2;   /* overflow slot holding several origins */
+    t->org[i].n++; t->org[i].t += dt;
+    if (ret == STATUS_TIMEOUT) goto name;
+    if (kind == MWS_ALERT && ret == STATUS_ALERTED)
+    {
+        unsigned int a = (t->tid >> 2) & 4095;
+        waker = mws_alert_tid[a];
+        st = __atomic_load_n( &mws_alert_time[a], __ATOMIC_ACQUIRE );
+    }
+    else if (woken)
+    {
+        struct mws_hinfo *e;
+        r = mws_root( (ULONG_PTR)woken );
+        if (!(e = mws_hget( r )) && r && r < 0xffffffffull)
+        {
+            e = mws_hslot( r );
+            e->handle = (uint32_t)r; e->root = (uint32_t)r; e->type = MWS_H_UNKNOWN;
+            e->creator_tid = 0; e->creator_mod = MWS_SYS; e->signal_tid = 0; e->signal_time = 0; e->queried = 0;
+        }
+        if (e)
+        {
+            if (!e->queried) { e->queried = 1; e->type = mws_query_type( (HANDLE)r ); }
+            st = __atomic_load_n( &e->signal_time, __ATOMIC_ACQUIRE );
+            waker = e->signal_tid;
+            cls_type = e->type; cls_mod = e->creator_mod;
+        }
+    }
+    if (st > t0 && st <= now) { lat = now - st; t->wlat.n++; t->wlat.t += lat; }
+    for (i = 0; i < MWS_NWK - 1 && waker && t->wk_tid[i] != waker && t->wk_tid[i]; i++) ;
+    if (!waker) i = MWS_NWK - 1;
+    else if (!t->wk_tid[i] && i < MWS_NWK - 1) t->wk_tid[i] = waker;
+    t->wk[i].n++; t->wk[i].t += dt;
+    if (r && r < 0xffffffffull)
+    {
+        for (i = 0; i < MWS_NHS - 1 && t->hs_root[i] != (uint32_t)r && t->hs_root[i]; i++) ;
+        if (!t->hs_root[i]) t->hs_root[i] = (uint32_t)r;
+        else if (t->hs_root[i] != (uint32_t)r) t->hs_root[i] = 1;
+        t->hs[i].n++; t->hs[i].t += dt;
+        if (lat) { t->hs_lat[i].n++; t->hs_lat[i].t += lat; }
+        t->hs_waker[i] = waker;
+    }
+    if (cls_type >= 0)
+    {
+        uint32_t key = 1 + cls_type * 128 + (cls_mod & 127);
+        int w;
+        for (i = 0; i < MWS_NCLS - 1 && t->cls_key[i] != key && t->cls_key[i]; i++) ;
+        if (!t->cls_key[i]) t->cls_key[i] = key;
+        else if (t->cls_key[i] != key) t->cls_key[i] = 0xffffffff;
+        t->cls[i].n++; t->cls[i].t += dt;
+        if (lat) { t->cls_lat[i].n++; t->cls_lat[i].t += lat; }
+        for (w = 0; w < 3 && t->cls_wk[i][w] != waker && t->cls_wkn[i][w]; w++) ;
+        if (w < 3) { t->cls_wk[i][w] = waker; t->cls_wkn[i][w]++; }
+    }
+name:
+    if (t->epoch != __atomic_load_n( &mws_epoch, __ATOMIC_RELAXED ))
+    {
+        t->epoch = mws_epoch;
+        pthread_getname_np( pthread_self(), t->name, sizeof(t->name) );
+    }
+}
+
+static void mws_print( uint64_t now )
+{
+    double ms = (double)mws_tb.numer / mws_tb.denom / 1e6;
+    struct mws_thread *t;
+    char line[8192];
+    int i, at;
+
+    pthread_mutex_lock( &mws_mod_lock );
+    for (; mws_nmod_printed < mws_nmod; mws_nmod_printed++)
+        fprintf( stderr, "macrunner_wait_mods pid=%d idx=%d name=%s system=%d base=%lx end=%lx\n", getpid(), mws_nmod_printed,
+                 mws_mod[mws_nmod_printed].name, mws_mod[mws_nmod_printed].system,
+                 (unsigned long)mws_mod[mws_nmod_printed].base, (unsigned long)mws_mod[mws_nmod_printed].end );
+    pthread_mutex_unlock( &mws_mod_lock );
+    for (t = __atomic_load_n( &mws_threads, __ATOMIC_ACQUIRE ); t; t = t->next)
+    {
+        struct thread_basic_info basic;
+        struct policy_timeshare_info ts;
+        mach_msg_type_number_t cnt = THREAD_BASIC_INFO_COUNT, cnt2 = POLICY_TIMESHARE_INFO_COUNT;
+        uint64_t cpu_us = 0, blocked = 0, waits = 0;
+        int base_pri = -1, cur_pri = -1, alive, lat = -1, thr = -1, imp = -99, tsh = -1;
+
+        alive = thread_info( t->port, THREAD_BASIC_INFO, (thread_info_t)&basic, &cnt ) == KERN_SUCCESS;
+        if (alive)
+        {
+            cpu_us = (uint64_t)(basic.user_time.seconds + basic.system_time.seconds) * 1000000 +
+                     basic.user_time.microseconds + basic.system_time.microseconds;
+            if (thread_info( t->port, THREAD_SCHED_TIMESHARE_INFO, (thread_info_t)&ts, &cnt2 ) == KERN_SUCCESS)
+            { base_pri = ts.base_priority; cur_pri = ts.cur_priority; }
+            {   /* the Mach policies wineserver sets (server/thread.c apply_thread_priority) */
+                struct thread_latency_qos_policy lq; struct thread_throughput_qos_policy tq;
+                struct thread_precedence_policy pp; struct thread_extended_policy ep;
+                mach_msg_type_number_t c; boolean_t def;
+                c = THREAD_LATENCY_QOS_POLICY_COUNT; def = FALSE;
+                if (thread_policy_get( t->port, THREAD_LATENCY_QOS_POLICY, (thread_policy_t)&lq, &c, &def ) == KERN_SUCCESS) lat = lq.thread_latency_qos_tier & 0xff;
+                c = THREAD_THROUGHPUT_QOS_POLICY_COUNT; def = FALSE;
+                if (thread_policy_get( t->port, THREAD_THROUGHPUT_QOS_POLICY, (thread_policy_t)&tq, &c, &def ) == KERN_SUCCESS) thr = tq.thread_throughput_qos_tier & 0xff;
+                c = THREAD_PRECEDENCE_POLICY_COUNT; def = FALSE;
+                if (thread_policy_get( t->port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&pp, &c, &def ) == KERN_SUCCESS) imp = pp.importance;
+                c = THREAD_EXTENDED_POLICY_COUNT; def = FALSE;
+                if (thread_policy_get( t->port, THREAD_EXTENDED_POLICY, (thread_policy_t)&ep, &c, &def ) == KERN_SUCCESS) tsh = ep.timeshare;
+            }
+        }
+        for (i = 0; i < MWS_NKIND; i++)
+        {
+            if (i != MWS_YIELD && i != MWS_DELAY0) blocked += t->k[i].t - t->pk[i].t;
+            waits += t->k[i].n - t->pk[i].n;
+        }
+        if (!waits && (!alive || cpu_us - t->pcpu_us < 1000)) continue;
+        at = snprintf( line, sizeof(line), "macrunner_wait_stats pid=%d t_ms=%.0f tid=%04x name=%s alive=%d cpu_ms=%.1f pri=%d/%d imp=%d ts=%d lq=%d tq=%d blocked_ms=%.1f"
+                       " to=%llu k=", getpid(), now * ms, t->tid, t->name[0] ? t->name : "-", alive,
+                       alive ? (cpu_us - t->pcpu_us) / 1000.0 : -1.0, base_pri, cur_pri, imp, tsh, lat, thr, blocked * ms,
+                       (unsigned long long)(t->timeouts - t->ptimeouts) );
+        for (i = 0; i < MWS_NKIND && at < (int)sizeof(line) - 64; i++)
+            if (t->k[i].n != t->pk[i].n)
+                at += snprintf( line + at, sizeof(line) - at, "%s:%llu:%.2f,", mws_kind_name[i],
+                                (unsigned long long)(t->k[i].n - t->pk[i].n), (t->k[i].t - t->pk[i].t) * ms );
+        at += snprintf( line + at, sizeof(line) - at, " org=" );
+        for (i = 0; i < MWS_NORG && at < (int)sizeof(line) - 64; i++)
+            if (t->org_mod[i] != -1 && t->org[i].n != t->porg[i].n)
+                at += snprintf( line + at, sizeof(line) - at, "%d:%llu:%.2f,", t->org_mod[i],
+                                (unsigned long long)(t->org[i].n - t->porg[i].n), (t->org[i].t - t->porg[i].t) * ms );
+        at += snprintf( line + at, sizeof(line) - at, " wk=" );
+        for (i = 0; i < MWS_NWK && at < (int)sizeof(line) - 64; i++)
+            if (t->wk[i].n != t->pwk[i].n)
+                at += snprintf( line + at, sizeof(line) - at, "%04x:%llu:%.2f,", i == MWS_NWK - 1 ? 0 : t->wk_tid[i],
+                                (unsigned long long)(t->wk[i].n - t->pwk[i].n), (t->wk[i].t - t->pwk[i].t) * ms );
+        at += snprintf( line + at, sizeof(line) - at, " wl=%llu:%.3f h=", (unsigned long long)(t->wlat.n - t->pwlat.n), (t->wlat.t - t->pwlat.t) * ms );
+        for (i = 0; i < MWS_NHS && at < (int)sizeof(line) - 128; i++)
+            if (t->hs_root[i] && t->hs[i].n != t->phs[i].n)
+            {
+                struct mws_hinfo *e = t->hs_root[i] > 1 ? mws_hget( t->hs_root[i] ) : NULL;
+                at += snprintf( line + at, sizeof(line) - at, "%x:%s:%d:%04x:%llu:%.2f:%llu:%.3f:%04x,", t->hs_root[i],
+                                e ? mws_htype_name[e->type < 6 ? e->type : 0] : "?", e ? e->creator_mod : -1, e ? e->creator_tid : 0,
+                                (unsigned long long)(t->hs[i].n - t->phs[i].n), (t->hs[i].t - t->phs[i].t) * ms,
+                                (unsigned long long)(t->hs_lat[i].n - t->phs_lat[i].n), (t->hs_lat[i].t - t->phs_lat[i].t) * ms, t->hs_waker[i] );
+            }
+        at += snprintf( line + at, sizeof(line) - at, " srvw=%llu:%.2f srv=", (unsigned long long)(t->srv_in_wait.n - t->psrv_in_wait.n),
+                        (t->srv_in_wait.t - t->psrv_in_wait.t) * ms );
+        {
+            int done[16], nd = 0, j, best;
+            for (nd = 0; nd < 16; nd++)
+            {
+                uint64_t bt = 0;
+                best = -1;
+                for (j = 0; j <= MWS_NREQ; j++)
+                {
+                    uint64_t d = t->srv[j].t - t->psrv[j].t;
+                    int k, used = 0;
+                    for (k = 0; k < nd; k++) if (done[k] == j) used = 1;
+                    if (!used && t->srv[j].n != t->psrv[j].n && d >= bt) { bt = d; best = j; }
+                }
+                if (best < 0) break;
+                done[nd] = best;
