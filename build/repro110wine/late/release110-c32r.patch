-    {
-        int pos = (min + max) / 2;
-
-        if (hash_entry[pos].Hash < hash) min = pos + 1;
-        else if (hash_entry[pos].Hash > hash) max = pos - 1;
-        else
-        {
-            *entry = (API_SET_NAMESPACE_ENTRY *)((char *)map + map->EntryOffset) + hash_entry[pos].Index;
