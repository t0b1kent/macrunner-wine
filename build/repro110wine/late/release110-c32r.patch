-/* Спросить Wine, был ли отказ на сторожевой странице, и НИЧЕГО больше не делать.
- * `virtual_handle_fault` при сторожe снимает бит (Windows отдаёт `80000001` один раз) и
- * возвращает `STATUS_GUARD_PAGE_VIOLATION`; на обычном отказе он возвращает нарушение
- * доступа и страницу не трогает. Признак читает место доставки. */
-static BOOL macrunner_hb_note_guard_page_ctx( void *user, hb_gva_t addr )
-{
-    EXCEPTION_RECORD rec = { 0 };
-    hb_context_t *ctx = (hb_context_t *)user;
-    ULONG_PTR host_addr = (ULONG_PTR)addr;
-
-    /* MacRunner 2026-08-16, лейн ЛЕСТНИЦА, итерация 1084 — АДРЕС ДЛЯ ЗАПРОСА ХОЗЯЙСКИЙ.
-     *
-     * `virtual_handle_fault` работает адресами ХОЗЯИНА. На x64 гостевой адрес и есть
-     * хозяйский, поэтому проба 1056 сразу заработала. На i386 гостевой адрес 32-битный, а
-     * память гостя лежит в отдельном окне (`guest32_base`), и запрос по 32-битному адресу
-     * попадал не туда: замер 1083 показал, что сторожевая страница на i386 приходит гостю
-     * как обычное нарушение доступа. Переводим адрес окна прежде, чем спрашивать. */
-    if (ctx && ctx->arch == HB_ARCH_X86 && ctx->guest32_base)
-        host_addr = (ULONG_PTR)(ctx->guest32_base + (uint32_t)addr);
-
-    rec.ExceptionCode = STATUS_ACCESS_VIOLATION;
-    rec.NumberParameters = 2;
-    rec.ExceptionInformation[0] = EXCEPTION_READ_FAULT;
-    rec.ExceptionInformation[1] = host_addr;
-    if (virtual_handle_fault( &rec, NULL ) != STATUS_GUARD_PAGE_VIOLATION) return FALSE;
-    macrunner_hb_pending_guard_page_addr = (unsigned long long)addr;
-    return TRUE;
-}
