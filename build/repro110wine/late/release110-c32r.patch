-{
-    return (struct m0_thread *)(macrunner_m0_base + MACRUNNER_M0_HDRSZ +
-        (size_t)i * (MACRUNNER_M0_THDRSZ + (size_t)MACRUNNER_M0_RING * MACRUNNER_M0_RECSZ));
