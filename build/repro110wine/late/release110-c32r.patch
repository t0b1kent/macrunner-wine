+        if ((op & 0x3b400000u) == 0x39400000u && (op & 0xc0000000u) == 0xc0000000u && (rt == 29 || rt == 30)) return FALSE; /* ldr fp/lr */
+        if ((op & 0x7f2003e0u) == 0x2a0003e0u && (rt == 29 || rt == 30)) return FALSE;          /* mov fp/lr, xN */
