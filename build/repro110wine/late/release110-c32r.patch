-static void macrunner_m0_publish( struct m0_rec *rec, uint64_t ticket, uint32_t kind,
-                                  struct m0_thread *t, uint64_t sig_id, uint64_t dump_id,
-                                  uint64_t scan_id, const void *payload, uint32_t plen )
