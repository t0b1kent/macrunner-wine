-static int macrunner_hb_region_cache_lookup( mach_vm_address_t addr, mach_vm_address_t *base,
-                                             mach_vm_size_t *size, vm_prot_t *prot )
-{
-    uint64_t gen = __atomic_load_n( &macrunner_hb_vm_generation_v, __ATOMIC_ACQUIRE );
