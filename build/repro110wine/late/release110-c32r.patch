-static void macrunner_hb_get_current_timezone_info( TIME_ZONE_INFORMATION *info )
-{
-    time_t now = time( NULL );
-    struct tm local_tm, utc_tm;
-    time_t local_as_utc, utc_as_utc;
-
-    memset( info, 0, sizeof(*info) );
