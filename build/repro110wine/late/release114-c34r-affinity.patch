-/******************************************************************************
- *              NtQueryInformationThread  (NTDLL.@)
+/* ===== SPEED114 20.11.2026 (Sonnet 5.5): MACRUNNER_THREAD_AFFINITY_FAST — safe-timer без wineserver =====
+ * «Безопасный таймер» игр 2005–2008 (Gothic 3 без PUP): SetThreadAffinityMask(GetCurrentThread(), ...) вокруг
+ * QueryPerformanceCounter. kernel32 делает NtQueryInformationThread(ThreadBasicInformation) + NtSetInformationThread
+ * (ThreadAffinityMask) = два RPC в wineserver на вызов. На macOS сервер маску не применяет (нет sched_setaffinity),
+ * только хранит thread->affinity. Ключ MACRUNNER_THREAD_AFFINITY_FAST=1 (по умолчанию 0): для ТЕКУЩЕГО потока
+ * (псевдохэндл NtCurrentThread) маска и снимок ThreadBasicInformation держатся в клиенте; изменённая маска («грязная»)
+ * записывается на сервер лениво — перед любой операцией над ЧУЖИМ хендлом (запрос/установка маски) и перед
+ * NtSetInformationProcess(ProcessAffinityMask), так что наблюдаемое через сервер совпадает с ключом 0.
+ * Быстрый путь включается, только если маска процесса покрывает все процессоры системы (проверка один раз).
+ * MACRUNNER_THREAD_AFFINITY_STATS=<файл> — раз в секунду дописывает счётчики вызовов Nt{Query,Set}InformationThread
+ * (по классам, свой/чужой хендл, вызовов и нс) — работает при любом значении ключа. */
+struct aff_tcache
+{
+    struct aff_tcache *next;
+    ULONG              tid;
+    ULONG_PTR          affinity;
+    int                dirty;
+    int                aff_valid;
+    unsigned int       epoch;
+    int                info_valid;
+    unsigned int       info_gen;
+    THREAD_BASIC_INFORMATION info;
+};
+
+static pthread_mutex_t aff_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct aff_tcache *aff_list;
+static __thread struct aff_tcache *aff_tls;
+static unsigned int aff_epoch = 1, aff_info_gen = 1;
+static int aff_mode = -1;          /* -1 не прочитан, 0 выкл, 1 вкл (после проверки маски процесса) */
+static int aff_stats_fd = -2;      /* -2 не прочитан, -1 выкл */
+
+static NTSTATUS nt_query_information_thread_impl( HANDLE handle, THREADINFOCLASS class, void *data, ULONG length, ULONG *ret_len );
+static NTSTATUS nt_set_information_thread_impl( HANDLE handle, THREADINFOCLASS class, const void *data, ULONG length );
+
+static int aff_fast_on(void)
+{
+    int m = __atomic_load_n( &aff_mode, __ATOMIC_ACQUIRE );
+    const char *e;
+    if (m >= 0) return m;
+    m = 0;
+    if ((e = getenv( "MACRUNNER_THREAD_AFFINITY_FAST" )) && e[0] == '1' && !e[1])
+    {
+        ULONG_PTR proc = 0, sys = get_system_affinity_mask();
+        if (!NtQueryInformationProcess( NtCurrentProcess(), ProcessAffinityMask, &proc, sizeof(proc), NULL ) &&
+            (proc & sys) == sys)
+            m = 1;
+    }
+    __atomic_store_n( &aff_mode, m, __ATOMIC_RELEASE );
+    return m;
+}
+
+static struct aff_tcache *aff_get_tls(void)
+{
+    struct aff_tcache *c = aff_tls;
+    if (c) return c;
+    if (!(c = calloc( 1, sizeof(*c) ))) return NULL;
+    c->tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    pthread_mutex_lock( &aff_lock );
+    c->next = aff_list;
+    aff_list = c;
+    pthread_mutex_unlock( &aff_lock );
+    aff_tls = c;
+    return c;
+}
+
+/* пишет на сервер все «грязные» маски потоков (перед операцией над чужим хендлом) */
+static void aff_flush_dirty(void)
+{
+    struct aff_tcache *c;
+    pthread_mutex_lock( &aff_lock );
+    for (c = aff_list; c; c = c->next)
+    {
+        CLIENT_ID cid;
+        HANDLE h;
+        ULONG_PTR mask;
+        if (!__atomic_exchange_n( &c->dirty, 0, __ATOMIC_ACQ_REL )) continue;
+        mask = __atomic_load_n( &c->affinity, __ATOMIC_ACQUIRE );
+        cid.UniqueProcess = NtCurrentTeb()->ClientId.UniqueProcess;
+        cid.UniqueThread  = ULongToHandle( c->tid );
+        if (NtOpenThread( &h, THREAD_SET_INFORMATION, NULL, &cid )) continue;
+        SERVER_START_REQ( set_thread_info )
+        {
+            req->handle   = wine_server_obj_handle( h );
+            req->affinity = mask;
+            req->mask     = SET_THREAD_INFO_AFFINITY;
+            wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        NtClose( h );
+    }
+    pthread_mutex_unlock( &aff_lock );
+}
+
+static inline int aff_cur_valid( struct aff_tcache *c )
+{
+    return c->aff_valid && (__atomic_load_n( &c->dirty, __ATOMIC_ACQUIRE ) ||
+                            c->epoch == __atomic_load_n( &aff_epoch, __ATOMIC_ACQUIRE ));
+}
+
+/* поток завершается: его «грязная» маска не должна попасть на новый поток с тем же TID */
+static void macrunner_thread_affinity_thread_exit( void )
+{
+    struct aff_tcache *c = aff_tls;
+    if (!c) return;
+    __atomic_store_n( &c->dirty, 0, __ATOMIC_RELEASE );
+    c->aff_valid = 0;
+    c->info_valid = 0;
+}
+
+/* вызывается из NtSetInformationProcess (process.c) */
+void macrunner_thread_affinity_process_set( int is_affinity )
+{
+    if (!aff_fast_on()) return;
+    if (is_affinity)
+    {
+        aff_flush_dirty();
+        __atomic_store_n( &aff_mode, 0, __ATOMIC_RELEASE );  /* маска процесса изменена — быстрый путь выключен насовсем */
+        __atomic_add_fetch( &aff_epoch, 1, __ATOMIC_ACQ_REL );
+    }
+    __atomic_add_fetch( &aff_info_gen, 1, __ATOMIC_ACQ_REL );
+}
+
+/* ---- счётчики ---- */
+#define AFF_NCLS 64
+static struct { unsigned long calls, ns; } aff_cnt[2][2][AFF_NCLS];   /* [set][чужой][класс] */
+static unsigned long aff_tid_calls[2][8], aff_tid_ids[8];
+static unsigned long aff_last_dump;
+static unsigned long aff_prev[2][2][AFF_NCLS][2];
+
+static void aff_stats_dump( unsigned long now )
+{
+    char buf[4096];
+    int n = 0, s, f, k, i;
+    n += snprintf( buf + n, sizeof(buf) - n, "AFFSTATS pid=%d t_ms=%lu mode=%d", (int)getpid(), now / 1000000, aff_mode );
+    for (s = 0; s < 2; s++) for (f = 0; f < 2; f++) for (k = 0; k < AFF_NCLS; k++)
+    {
+        unsigned long c = __atomic_load_n( &aff_cnt[s][f][k].calls, __ATOMIC_RELAXED );
+        unsigned long t = __atomic_load_n( &aff_cnt[s][f][k].ns, __ATOMIC_RELAXED );
+        if (c == aff_prev[s][f][k][0]) continue;
+        n += snprintf( buf + n, sizeof(buf) - n, " %s:cls%d:%s=%lu/%luns", s ? "set" : "qry", k, f ? "foreign" : "cur",
+                       c - aff_prev[s][f][k][0], t - aff_prev[s][f][k][1] );
+        aff_prev[s][f][k][0] = c; aff_prev[s][f][k][1] = t;
+    }
+    for (i = 0; i < 8; i++)
+        if (aff_tid_ids[i]) n += snprintf( buf + n, sizeof(buf) - n, " tid%lu=%lu+%lu", aff_tid_ids[i], aff_tid_calls[0][i], aff_tid_calls[1][i] );
+    buf[n++] = '\n';
+    write( aff_stats_fd, buf, n );
+}
+
+static void aff_stats_note( int set, HANDLE handle, int class, unsigned long t0 )
+{
+    unsigned long now = clock_gettime_nsec_np( CLOCK_UPTIME_RAW );
+    int f = handle != NtCurrentThread(), k = class >= 0 && class < AFF_NCLS ? class : AFF_NCLS - 1, i;
+    unsigned long tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    __atomic_add_fetch( &aff_cnt[set][f][k].calls, 1, __ATOMIC_RELAXED );
+    __atomic_add_fetch( &aff_cnt[set][f][k].ns, now - t0, __ATOMIC_RELAXED );
+    for (i = 0; i < 8; i++)
+    {
+        unsigned long cur = __atomic_load_n( &aff_tid_ids[i], __ATOMIC_RELAXED );
+        if (!cur) { unsigned long z = 0; if (__atomic_compare_exchange_n( &aff_tid_ids[i], &z, tid, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) cur = tid; else cur = z; }
+        if (cur == tid) { __atomic_add_fetch( &aff_tid_calls[set][i], 1, __ATOMIC_RELAXED ); break; }
+    }
+    {
+        unsigned long last = __atomic_load_n( &aff_last_dump, __ATOMIC_RELAXED );
+        if (now - last >= 1000000000UL &&
+            __atomic_compare_exchange_n( &aff_last_dump, &last, now, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED ))
+            aff_stats_dump( now );
+    }
+}
+
+static int aff_stats_on(void)
+{
+    int fd = __atomic_load_n( &aff_stats_fd, __ATOMIC_ACQUIRE );
+    if (fd != -2) return fd >= 0;
+    {
+        const char *e = getenv( "MACRUNNER_THREAD_AFFINITY_STATS" );
+        fd = -1;
+        if (e && e[0] && strcmp( e, "0" )) fd = open( e, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644 );
+        __atomic_store_n( &aff_stats_fd, fd, __ATOMIC_RELEASE );
+    }
+    return fd >= 0;
+}
