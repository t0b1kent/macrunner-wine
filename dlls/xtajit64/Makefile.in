MODULE    = xtajit64.dll
UNIXLIB   = xtajit64.so
IMPORTS   = ntdll
EXTRADEFS = -D_CRTIMP=
EXTRAINCL = -I$(top_srcdir)/../hyperbridge/include
UNIX_CFLAGS = -I$(top_srcdir)/../hyperbridge/include
UNIX_LIBS = $(top_srcdir)/../hyperbridge/libhyperbridge.a

EXTRADLLFLAGS = -nodefaultlibs

SOURCES = \
	cpu.c \
	unixlib.c
